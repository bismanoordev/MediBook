# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only: used solely to look up authenticated booking recipients after an
# already-authorized appointment action. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Server-only Resend transactional email configuration.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="MediBook <bookings@your-domain.com>"

# Public absolute URL used in email action buttons.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Development safety: emails are suppressed outside production unless test mode
# is enabled. With test mode on, every email goes only to this safe inbox.
EMAIL_TEST_MODE=false
EMAIL_TEST_RECIPIENT=your-safe-test-inbox@example.com
